# TGJU Data Collector Configuration

# Database Connection String
# For Windows with Trusted Connection:
TGJU_DB_CONNECTION=mssql+pyodbc://username@SERVERNAME/database_name?driver=ODBC+Driver+17+for+SQL+Server&trusted_connection=yes

# For SQL Authentication:
# TGJU_DB_CONNECTION=mssql+pyodbc://username:password@server:1433/database_name?driver=ODBC+Driver+17+for+SQL+Server

# For Azure SQL Database:
# TGJU_DB_CONNECTION=mssql+pyodbc://username:password@server.database.windows.net:1433/database_name?driver=ODBC+Driver+17+for+SQL+Server

# Copy this file to .env and fill in your actual credentials
# .env file is ignored by git for security
