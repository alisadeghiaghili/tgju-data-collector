# TGJU DB URL (SQLAlchemy). Default is local SQLite.
# TGJU_DB_URL=sqlite:///tgju_collector.db
# TGJU_DB_URL=mssql+pyodbc://user:pass@host:1433/dbname?driver=ODBC+Driver+17+for+SQL+Server

# HTTP policy (keep delays generous to stay well under rate limits)
TGJU_HTTP_TIMEOUT=30
TGJU_HTTP_MAX_RETRIES=3
TGJU_REQUEST_DELAY_MIN=1.2
TGJU_REQUEST_DELAY_MAX=2.8
# Optional: override User-Agent (default is a normal desktop Chrome UA)
# TGJU_USER_AGENT=Mozilla/5.0 ...

# Market timezone
TGJU_MARKET_TZ=Asia/Tehran

# Logging
TGJU_LOG_LEVEL=INFO

# Backfill window (days)
TGJU_BACKFILL_MAX_DAYS=730
