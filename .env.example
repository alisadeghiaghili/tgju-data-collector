# TGJU Data Collector Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to version control!

# ===== DATABASE CONFIGURATION =====
# SQL Server connection details
# Use either complete CONNECTION_STRING or individual components

# Option 1: Complete connection string (takes priority if set)
# TGJU_DB_CONNECTION_STRING=mssql+pyodbc://username:password@server:1433/database?driver=ODBC+Driver+17+for+SQL+Server

# Option 2: Individual components (used if CONNECTION_STRING not set)
TGJU_DB_SERVER=localhost
TGJU_DB_NAME=tgju
TGJU_DB_USER=sa
TGJU_DB_PASSWORD=YourSecurePassword123!
TGJU_DB_DRIVER=ODBC Driver 17 for SQL Server
TGJU_DB_PORT=1433

# Database table name (optional, defaults to TgjuAssets)
# TGJU_DB_TABLE_NAME=TgjuAssets


# ===== API CONFIGURATION =====
API_TIMEOUT=100000
API_MAX_RETRIES=3


# ===== LOGGING CONFIGURATION =====
LOG_LEVEL=INFO
LOG_DIR=logs
