# TGJU Data Collector - Environment Variables Configuration Template
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to version control!

# ==============================================================================
# Database Configuration (for tgjuScraper.py)
# ==============================================================================

# Option 1: Individual components (recommended)
TGJU_DB_SERVER=your_sql_server_hostname
TGJU_DB_NAME=your_database_name
TGJU_DB_USER=your_username
TGJU_DB_PASSWORD=your_secure_password
TGJU_DB_DRIVER=ODBC Driver 17 for SQL Server
TGJU_DB_PORT=1433

# Option 2: Complete connection string (overrides individual settings)
# TGJU_DB_CONNECTION_STRING=mssql+pyodbc://username:password@server:1433/database?driver=ODBC+Driver+17+for+SQL+Server

# Database Table Configuration
TGJU_DB_TABLE_NAME=TgjuAssets

# ==============================================================================
# Security Notes
# ==============================================================================
#
# 1. After copying to .env, replace all 'your_*' placeholders with actual values
# 2. Use strong passwords (minimum 12 characters, mixed case, numbers, symbols)
# 3. Never commit .env file to Git (add to .gitignore)
# 4. For production, consider using Azure Key Vault or similar secret management
# 5. For Windows Authentication, you may use trusted_connection=yes in connection string
#    Example: TGJU_DB_CONNECTION_STRING=mssql+pyodbc://user@server/db?driver=ODBC+Driver+17+for+SQL+Server&trusted_connection=yes
#
